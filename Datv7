    button.Size = UDim2.new(1, -24, 0, 42)
    button.Position = UDim2.fromOffset(12, 55 + (order - 1) * 49)
    button.BackgroundColor3 = Color3.fromRGB(38, 38, 43)
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = true
    button.Parent = main

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    local border = Instance.new("UIStroke")
    border.Color = Color3.fromRGB(180, 25, 40)
    border.Thickness = 1
    border.Parent = button

    return button
end

-- EFFECT MANAGEMENT
local function disableEffect(obj)
    if saved[obj] then return end

    local properties = {}

    if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Fire")
        or obj:IsA("Smoke")
        or obj:IsA("Sparkles")
        or obj:IsA("PostEffect")
        or obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then

        properties.Enabled = obj.Enabled
        saved[obj] = properties
        obj.Enabled = false

    elseif obj:IsA("BasePart")
        and obj.Material == Enum.Material.Neon then

        properties.Material = obj.Material
        saved[obj] = properties
        obj.Material = Enum.Material.SmoothPlastic
    end
end

local function removeEffects()
    for _, obj in ipairs(Lighting:GetDescendants()) do
        disableEffect(obj)
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        disableEffect(obj)
    end
end

local function startFixLag()
    enabled = true
    removeEffects()

    Lighting.GlobalShadows = false

    table.insert(connections, Workspace.DescendantAdded:Connect(function(obj)
        if enabled then
            task.defer(function()
                if enabled and obj.Parent then
                    disableEffect(obj)
                end
            end)
        end
    end))

    table.insert(connections, Lighting.DescendantAdded:Connect(function(obj)
        if enabled then
            task.defer(function()
                if enabled and obj.Parent then
                    disableEffect(obj)
                end
            end)
        end
    end))
end

local function restoreEffects()
    enabled = false

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)

    for obj, properties in pairs(saved) do
        if obj and obj.Parent then
            pcall(function()
                for property, value in pairs(properties) do
                    obj[property] = value
                end
            end)
        end
    end
    table.clear(saved)

    Lighting.GlobalShadows = true
end

