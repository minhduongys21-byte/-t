--==================================================
-- CHỨC NĂNG FLY TRÊN ĐIỆN THOẠI
--==================================================

local flyAttachment
local flyVelocity
local flyGyro

local function stopFly()
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end

    flyControlFrame.Visible = false
    local humanoid = getHumanoid()
    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function startFly(root)
    stopFly()

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "DAT_CHUA_FlyAttachment"
    flyAttachment.Parent = root

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Name = "DAT_CHUA_FlyVelocity"
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    flyVelocity.MaxForce = 1000000
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("AlignOrientation")
    flyGyro.Name = "DAT_CHUA_FlyGyro"
    flyGyro.Attachment0 = flyAttachment
    flyGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
    flyGyro.Responsiveness = 200
    flyGyro.MaxTorque = 1000000
    flyGyro.Parent = root

    flyControlFrame.Visible = true
end

--==================================================
-- KIỂM TRA ĐỒNG ĐỘI
--==================================================

local function isTeammate(targetPlayer)
    if not Config.TeamCheck then return false end
    if player.Team and targetPlayer.Team and player.Team == targetPlayer.Team then
        return true
    end
    return false
end

--==================================================
-- AIM ASSIST
--==================================================

local function getAimTarget()
    local character = getCharacter()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local currentCamera = workspace.CurrentCamera
    if not currentCamera then return nil end

    local viewport = currentCamera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local bestTarget
    local bestDistance = Config.FOV
    local pointingAtTeammate = false

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local targetCharacter = targetPlayer.Character
            local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
            local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            local targetHead = targetCharacter and targetCharacter:FindFirstChild("Head")

            if targetHumanoid and targetHumanoid.Health > 0 and targetRoot and targetHead and (targetRoot.Position - root.Position).Magnitude <= 300 then
                local screenPoint, visible = currentCamera:WorldToViewportPoint(targetHead.Position)

                if visible and screenPoint.Z > 0 then
                    local point = Vector2.new(screenPoint.X, screenPoint.Y)
                    local distance = (point - center).Magnitude

                    if distance < bestDistance then
                        if isTeammate(targetPlayer) then
                            pointingAtTeammate = true
                        else
                            local params = RaycastParams.new()
                            params.FilterType = Enum.RaycastFilterType.Exclude
                            params.FilterDescendantsInstances = {character}

                            local origin = currentCamera.CFrame.Position
                            local direction = targetHead.Position - origin
                            local result = workspace:Raycast(origin, direction, params)

                            if result and result.Instance:IsDescendantOf(targetCharacter) then
                                bestDistance = distance
                                bestTarget = targetHead
                            end
                        end
                    end
                end
            end
        end
    end

    if Config.AimAssist then
        fovCircle.Visible = true
        fovCircle.Radius = Config.FOV
        fovCircle.Position = center
        if pointingAtTeammate then
            fovCircle.Color = Color3.fromRGB(255, 0, 0)
        else
            fovCircle.Color = Color3.fromRGB(0, 255, 255)
        end
    else
        fovCircle.Visible = false
    end

    return bestTarget
end

RunService:BindToRenderStep(
    "DAT_CHUA_AimAssist",
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        if not Config.AimAssist then
            fovCircle.Visible = false
            return
        end

        local currentCamera = workspace.CurrentCamera
        local target = getAimTarget()
        if not currentCamera or not target then return end

        local desiredCFrame = CFrame.lookAt(currentCamera.CFrame.Position, target.Position)
        local strengthValue = Config.AimStrength or 50
        local lerpFactor = math.clamp((strengthValue / 100) * (deltaTime * 30), 0.01, 1)

        currentCamera.CFrame = currentCamera.CFrame:Lerp(desiredCFrame, lerpFactor)
    end
)

--==================================================
-- VÒNG LẶP CHÍNH (XỬ LÝ FLY BẰNG JOYSTICK DI ĐỘNG)
--==================================================

RunService.Heartbeat:Connect(function()
    local character = getCharacter()
    local humanoid = getHumanoid()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local camera = workspace.CurrentCamera

    for _, highlight in pairs(espObjects) do
        if highlight and highlight.Parent then
            highlight.Enabled = Config.ESP
        end
    end

    if humanoid then
        humanoid.WalkSpeed = Config.Speed and Config.SpeedValue or 16
    end

    if Config.Fly and root and humanoid and camera then
        if not flyVelocity or not flyVelocity.Parent then
            startFly(root)
        end

        humanoid.PlatformStand = true
        flyGyro.CFrame = camera.CFrame

        -- Lấy hướng di chuyển từ Joystick gốc của Roblox trên điện thoại
        local moveDir = humanoid.MoveDirection
        local finalDir = camera.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z))

        -- Thêm độ cao khi bấm nút Lên (▲) hoặc Xuống (▼) trên màn hình
        local verticalMove = 0
        if isFlyingUp then
            verticalMove = 1
        elseif isFlyingDown then
            verticalMove = -1
        end

        local totalMove = finalDir + Vector3.new(0, verticalMove, 0)

        if totalMove.Magnitude > 0 then
            flyVelocity.VectorVelocity = totalMove.Unit * (Config.FlyValue * 2)
        else
            flyVelocity.VectorVelocity = Vector3.zero
        end
    else
        stopFly()
    end
end)

