local function createToggle(label, key)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 52)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 15
    button.Font = Enum.Font.GothamMedium
    button.Parent = content

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

    local function refresh()
        button.Text = label .. " : " .. (Config[key] and "ON" or "OFF")
        button.BackgroundColor3 = Config[key]
            and Color3.fromRGB(0, 120, 105)
            or Color3.fromRGB(40, 40, 52)
        
        -- Hiển thị cụm nút điều khiển Fly khi bật tính năng Fly
        if key == "Fly" then
            flyControlFrame.Visible = Config[key]
        end
    end

    button.Activated:Connect(function()
        Config[key] = not Config[key]
        refresh()
    end)

    refresh()
    return button
end

